{
  "name": "feedback-widget",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-project feedback widget for in-app bug reports during dev/QA phases",
  "author": "Benoît Bremaud",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "sonar": "pnpm build && pnpm test:coverage && sonar-scanner-npm",
    "verify": "./scripts/verify.sh",
    "prepare": "git config core.hooksPath .githooks",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.6",
    "prettier": "^3.9.10",
    "sonarqube-scanner": "5.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "ws@>=8.0.0 <8.20.1": ">=8.20.1",
      "brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6",
      "vite@>=8.0.0 <8.0.16": ">=8.0.16"
    }
  }
}
