[Unit]
Description=Nightly local CI of feedback-widget: just nightly, tier L3 (#163), on a clean origin/main worktree (#171)
OnFailure=feedback-widget-local-ci-nightly-failed.service

[Service]
Type=oneshot
# The user manager's PATH has no ~/.local/bin, where mise lives; mise brings the pinned tools.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=REPO=%h/Documents/02_personal/feedback-widget WT=%h/.cache/nightly/feedback-widget
# Never the working checkout: it may sit on a feature branch or behind origin/main (agents-skills#427).
# '-': a catch-up run before the network is up uses the last fetched origin/main.
ExecStartPre=-/usr/bin/git -C ${REPO} fetch --quiet origin main
ExecStartPre=/bin/sh -c 'test -d "$WT" || git -C "$REPO" worktree add --detach "$WT" origin/main'
ExecStartPre=/usr/bin/git -C ${WT} reset --quiet --hard origin/main
ExecStartPre=/usr/bin/git -C ${WT} clean -ffdq
ExecStartPre=%h/.local/bin/mise trust --quiet ${WT}
ExecStartPre=/bin/sh -c 'cd "$WT" && exec mise x -- pnpm install --frozen-lockfile --ignore-scripts'
ExecStart=/bin/sh -c 'cd "$WT" && exec mise x -- just nightly'
