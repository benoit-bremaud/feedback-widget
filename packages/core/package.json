{
  "name": "@benoit-bremaud/feedback-widget-core",
  "version": "0.5.2",
  "description": "Pure-logic core for the feedback widget — domain, ports, use-cases, config. Runs in any JS runtime.",
  "author": "Benoît Bremaud",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benoit-bremaud/feedback-widget.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/benoit-bremaud/feedback-widget/tree/main/packages/core",
  "bugs": {
    "url": "https://github.com/benoit-bremaud/feedback-widget/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=20"
  }
}
