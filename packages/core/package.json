{
  "name": "@benoit-bremaud/feedback-widget-core",
  "version": "0.1.0",
  "description": "Pure-logic core for the feedback widget — domain, ports, use-cases, config. Runs in any JS runtime.",
  "author": "Benoît Bremaud",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=20"
  }
}
